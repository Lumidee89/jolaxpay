<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Pinned regardless of the developer's local .env (e.g. a real
             VTPASS_ENV=vtpass while testing sandbox integration by hand) —
             the suite must never call a real third-party API. Tests that
             specifically want to exercise a live driver's request/response
             parsing (see VtpassElectricityProviderTest) instantiate it
             directly with Http::fake(), bypassing this. -->
        <env name="VENDING_ELECTRICITY_DRIVER" value="mock"/>
        <env name="VENDING_AIRTIME_DRIVER" value="mock"/>
        <env name="VENDING_DATA_DRIVER" value="mock"/>
        <env name="VENDING_CABLE_TV_DRIVER" value="mock"/>
        <env name="VENDING_EDUCATION_DRIVER" value="mock"/>
        <env name="PAYMENTS_DOMESTIC_DRIVER" value="mock"/>
        <env name="PAYMENTS_INTERNATIONAL_DRIVER" value="mock"/>
        <env name="SMS_DRIVER" value="log"/>
        <env name="WHATSAPP_DRIVER" value="log"/>
        <env name="AUTH_BYPASS_LOGIN_OTP" value="false"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
