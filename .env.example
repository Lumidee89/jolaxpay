APP_NAME=JolaxPay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev: SQLite (zero config). Staging/Production: PostgreSQL (required —
# the ledger needs strong transactional guarantees per the TRD).
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=jolaxpay
# DB_USERNAME=jolaxpay
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=jolaxpay

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@jolaxpay.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Realtime (Laravel Reverb) ---
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Vending providers (DisCo / telecom) ---
# Each provider driver reads its own block. VENDING_ELECTRICITY_DRIVER selects
# the active implementation behind App\Domain\Vending\Contracts\VendingProvider.
VENDING_ELECTRICITY_DRIVER=morevalue
VENDING_ELECTRICITY_BASE_URL=
VENDING_ELECTRICITY_API_KEY=
VENDING_ELECTRICITY_API_SECRET=

# VTpass (https://vtpass.com/documentation/) — set VENDING_ELECTRICITY_DRIVER=vtpass
# above to activate. Get these from your VTpass dashboard's API Keys tab
# (sandbox and live are separate accounts with separate keys).
VTPASS_ENV=sandbox
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

# Airtime/data/cable_tv/education (PRD §7.1 Phase 2) — biller-anchored
# services (App\Models\Biller), all served by the same VTpass credentials
# above via VtpassBillerProvider. Flip each on independently once you're
# ready to test it against your VTpass sandbox.
VENDING_AIRTIME_DRIVER=morevalue
VENDING_DATA_DRIVER=morevalue
VENDING_CABLE_TV_DRIVER=morevalue
VENDING_EDUCATION_DRIVER=mock

# Schedwave (https://schedwave.com/api-docs) — use `schedwave` for any of
# the VENDING_*_DRIVER values above after adding the server-side API key.
SCHEDWAVE_BASE_URL=https://schedwave.com/api/v1
SCHEDWAVE_API_KEY=
SCHEDWAVE_TIMEOUT=30

MOREVALUE_BASE_URL=https://morevaluedigital.com.ng/api
MOREVALUE_API_TOKEN=
MOREVALUE_TIMEOUT=30
MOREVALUE_IKEDC_PROVIDER_ID=1
MOREVALUE_EKEDC_PROVIDER_ID=2
MOREVALUE_AEDC_PROVIDER_ID=
MOREVALUE_PHED_PROVIDER_ID=
MOREVALUE_KEDCO_PROVIDER_ID=
MOREVALUE_EEDC_PROVIDER_ID=
MOREVALUE_IBEDC_PROVIDER_ID=6
MOREVALUE_BEDC_PROVIDER_ID=
MOREVALUE_JED_PROVIDER_ID=
MOREVALUE_KAEDCO_PROVIDER_ID=

# --- Payments processor ---
# Selects the active implementation behind App\Domain\Payments\Contracts\PaymentProcessor.
PAYMENTS_DOMESTIC_DRIVER=safehaven
PAYMENTS_DOMESTIC_PUBLIC_KEY=
PAYMENTS_DOMESTIC_SECRET_KEY=

PAYMENTS_INTERNATIONAL_DRIVER=mock
PAYMENTS_INTERNATIONAL_PUBLIC_KEY=
PAYMENTS_INTERNATIONAL_SECRET_KEY=

# Safe Haven MFB: create an OAuth app and settlement/debit account in its dashboard.
SAFEHAVEN_BASE_URL=https://api.sandbox.safehavenmfb.com
SAFEHAVEN_OAUTH_CLIENT_ID=
SAFEHAVEN_IBS_CLIENT_ID=
SAFEHAVEN_COMPANY_URL=
SAFEHAVEN_PRIVATE_KEY_PATH=
SAFEHAVEN_DEBIT_ACCOUNT_NUMBER=
SAFEHAVEN_SETTLEMENT_BANK_CODE=999240
SAFEHAVEN_WEBHOOK_URL=https://example.com/api/v1/webhooks/safehaven
SAFEHAVEN_VIRTUAL_ACCOUNT_TTL=900
SAFEHAVEN_TIMEOUT=30

# --- Notification channels ---
# BulkSMSLive.com (https://www.bulksmslive.com) — set SMS_DRIVER=bulksmslive
# to activate real OTP delivery (new-device login challenge). Needs either
# SMS_API_KEY (get it from the dashboard's profile-summary page — preferred,
# revocable without touching the account password) OR SMS_EMAIL+SMS_PASSWORD
# (the account login itself). Only one pair is required.
SMS_DRIVER=log
SMS_API_KEY=
SMS_EMAIL=
SMS_PASSWORD=
SMS_SENDER_ID=JolaxPay

WHATSAPP_DRIVER=log
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Identity ---
# Temporary escape hatch: skips the new-device login OTP challenge
# entirely (see config/identity.php) — for use before a real SMS_DRIVER
# exists, since with SMS_DRIVER=log the OTP code only reaches the log
# file. Leave false; only flip true short-term, never in production.
AUTH_BYPASS_LOGIN_OTP=false
